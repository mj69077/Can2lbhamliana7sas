<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockscreen_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_luxury"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <!-- Icon and Next Prayer -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_lockscreen_next_prayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕌 العصر بعد 01:45"
            android:textColor="#F4E8C1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_lockscreen_location_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="مكة المكرمة • 1 رمضان 1447"
            android:textColor="#A0DFC3"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Fast Status or Next Time -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_pill"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_lockscreen_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03:30 م"
            android:textColor="#E2B84D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_lockscreen_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="موعد الصلاة"
            android:textColor="#D0ECD8"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
